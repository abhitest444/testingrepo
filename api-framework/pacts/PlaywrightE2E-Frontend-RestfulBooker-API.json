      "response": {
        "body": {
          "content": {
            "bookingdates": {
              "checkin": "2013-02-23",
              "checkout": "2014-10-23"
            },
            "depositpaid": true,
            "firstname": "Sally",
            "lastname": "Broccoli",
            "totalprice": 111
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
