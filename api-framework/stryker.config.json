{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker/master/packages/core/schema/stryker-core.json",
  "mutate": [
    "src/**/*.ts",
    "!src/config.ts"
  ],
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts",
    "related": false
  },
  "coverageAnalysis": "perTest",
  "tempDirName": ".stryker-tmp",
  "reporters": ["html", "clear-text", "progress", "json"],
  "jsonReporter": {
    "fileName": "reports/mutation-report.json"
  },
  "htmlReporter": {
    "fileName": "reports/mutation-report.html"
  },
  "clearTextReporter": {
    "allowEmojis": true
  },
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 50
  },
  "mutator": {
    "plugins": ["typescript"],
    "excludedMutations": [
      "StringLiteral"
    ]
  },
  "timeoutMS": 60000,
  "concurrency": 2
}
