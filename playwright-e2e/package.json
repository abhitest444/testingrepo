{
  "name": "playwright-e2e",
  "version": "1.0.0",
  "description": "Playwright TypeScript e2e framework — POM, storageState, API, a11y, visual, Allure, Cucumber BDD",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:smoke": "playwright test --grep @smoke",
    "test:smoke:portfolio": "playwright test --project=chromium --project=unauthenticated --project=api --grep @smoke",
    "test:e2e": "playwright test --project=chromium",
    "test:api": "playwright test --project=api",
    "test:a11y": "playwright test --grep @a11y --project=chromium",
    "test:unauthenticated": "playwright test --project=unauthenticated",
    "test:chromium": "playwright test --project=chromium --project=unauthenticated --project=api",
    "test:mobile": "playwright test --project=mobile-chrome",
    "test:visual": "playwright test --project=chromium --grep @visual",
    "test:visual:update": "playwright test --project=chromium --grep @visual --update-snapshots",
    "test:advanced": "playwright test --project=chromium --project=unauthenticated --grep '@soft|@clock|@visual'",
    "test:cucumber": "cucumber-js",
    "test:cucumber:smoke": "cucumber-js --tags '@smoke and @cucumber'",
    "report": "playwright show-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "playwright",
    "e2e",
    "qa",
    "automation",
    "api-testing",
    "accessibility",
    "cucumber",
    "bdd",
    "allure",
    "visual-testing"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@cucumber/cucumber": "^13.2.0",
    "@playwright/test": "^1.54.1",
    "@types/node": "^22.16.5",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.10.2",
    "dotenv": "^16.6.1",
    "pixelmatch": "^5.3.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3"
  }
}
