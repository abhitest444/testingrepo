{
  "id": "time-tracking-ui",
  "hasLayers": true,
  "manifestVersion": "4",
  "extensions": {
    "routes": [
      {
        "path": "qtime",
        "widget": {
          "id": "time-tracking-ui/timetrackingui",
          "appScreen": "shell"
        }
      },
      {
        "path": "timeactivity",
        "widget": {
          "id": "time-tracking-ui/singleTimeTrowser",
          "appScreen": "trowserV2",
          "extendedProperties": {
            "showTrowser": true
          }
        }
      },
      {
        "path": "timeimportagentic",
        "widget": {
          "id": "time-tracking-ui/timeImportAgentic",
          "appScreen": "trowserV2",
          "extendedProperties": {
            "showTrowser": true
          }
        }
      },
      {
        "path": "timetracking",
        "widget": {
          "id": "time-tracking-ui/weeklyTimeTrowser",
          "appScreen": "trowserV2",
          "extendedProperties": {
            "showTrowser": true
          }
        }
      },
      {
        "path": "timetracking/homepage",
        "widget": {
          "id": "time-tracking-ui/ttoHomePage",
          "appScreen": "shell"
        }
      },
      {
        "path": "timetracking/detail",
        "widget": {
          "id": "timecapture-timeentries-ui/time-tracking-only-detail",
          "appScreen": "shell"
        },
        "requiredPermissions": {
          "irn:intuit::qbo:employees:list:ui": ["read"]
        }
      },
      {
        "path": "timetrackingsettings",
        "widget": {
          "id": "time-tracking-ui/timeTrackingSettings",
          "appScreen": "shell"
        }
      },
      {
        "path": "timeclock",
        "widget": {
          "id": "time-tracking-ui/timeClock",
          "appScreen": "shell"
        }
      },
      {
        "path": "timeentryweekly",
        "widget": {
          "id": "time-tracking-ui/weeklyTimeEntry",
          "appScreen": "shell"
        }
      },
      {
        "path": "customfield",
        "widget": {
          "id": "time-tracking-ui/customField",
          "appScreen": "shell"
        }
      },
      {
        "path": "quickfind",
        "widget": {
          "id": "time-tracking-ui/quickFind",
          "appScreen": "shell"
        }
      },
      {
        "path": "time-tracking-ui/assignments",
        "accessLevel": "GUEST",
        "widget": {
          "id": "time-tracking-ui/assignments",
          "appScreen": "shell"
        }
      },
      {
        "path": "userSettings/:workerId/:workerType/:workerName",
        "accessLevel": "GUEST",
        "widget": {
          "id": "time-tracking-ui/userSettings",
          "appScreen": "shell"
        }
      },
      {
        "path": "time-tracking-ui/whosworking",
        "accessLevel": "GUEST",
        "widget": {
          "id": "time-tracking-ui/whosworking",
          "appScreen": "shell"
        }
      },
      {
        "path": "timeproject",
        "accessLevel": "GUEST",
        "widget": {
          "id": "time-tracking-ui/timeProject",
          "appScreen": "shell"
        }
      }
    ]
  },
  "widgets": {
