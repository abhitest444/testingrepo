  "webtoolsManager": {
    "tools": {
      "@appfabric/plugin-cli": "4.x"
    }
  },
  "scripts": {
    "align": "plugin-cli align",
    "lint": "plugin-cli lint",
    "lint:test": "plugin-cli lint:test",
    "build": "plugin-cli build",
    "serve": "plugin-cli serve --no-open",
    "test": "plugin-cli test:jest",
    "test:jest": "plugin-cli test:jest",
    "test:lighthouse": "plugin-cli test:lighthouse --verify",
    "test:playwright": "PLAYWRIGHT_ENV=preprod playwright test --project chromium",
    "test:playwright:local": "./test/automation/playwright/checkLocalRunning.sh && PLAYWRIGHT_ENV=local playwright test --project chromium",
    "test:playwright:prod": "PLAYWRIGHT_ENV=prod playwright test --project chromium-prod",
    "test:playwright:prod:te:ies": "PLAYWRIGHT_ENV=prod TEST_ACCOUNT=IES playwright test test/automation/playwright/flows/FastPipeline/TimeEntriesFlows.spec.ts --project=chromium-prod",
    "prerelease": "plugin-cli build -p",
    "test:cypress": "echo cypress",
    "release": "plugin-cli release",
    "verify-dev-setup": "npx --yes -p @appfabric/scripts verify-dev-setup",
    "awm:bootstrap": "is-ci || (appf-webtools-mgr version && appf-webtools-mgr bootstrap) || echo 'Skipping bootstrap since webtools manager is not installed: https://github.intuit.com/pages/UX-Infra/webtools-mgr/docs/getting-started'",
    "postinstall": "yarn awm:bootstrap",
    "prettify": "prettier --write --loglevel warn --ignore-unknown .",
    "prettier-check": "prettier --check --loglevel warn --ignore-unknown .",
    "lint:ci": "yarn prettier-check && plugin-cli lint",
    "fetchschema": "yarn fetchschema:timetracking && yarn fetchschema:oigql && yarn fetchschema:gas",
    "fetchschema:timetracking": "./codegen/timetracking/fetchSchema.sh",
    "fetchschema:oigql": "./codegen/oigql/fetchSchema.sh",
    "fetchschema:gas": "./codegen/gas/fetchSchema.sh",
    "generate": "yarn generate:timetracking && yarn generate:oigql && yarn generate:gas",
    "generate:timetracking": "graphql-codegen -r ts-node/register --config codegen/timetracking/codegen.ts --debug",
    "generate:oigql": "graphql-codegen -r ts-node/register --config codegen/oigql/codegen.ts --debug",
    "generate:gas": "graphql-codegen -r ts-node/register --config codegen/gas/codegen.ts --debug"
  },
